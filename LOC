def filter_message(text):
    text = bleach.clean(text, strip=True)
    lower = text.lower()
    for w in BAD_WORDS:
        if w in lower:
            return None, "Nội dung vi phạm (chửi bậy) / Content violation (swearing)"
    for p in GAMBLING_PATTERNS:
        if re.search(p, lower):
            return None, "Quảng cáo web cá cược bị cấm / Gambling site promotion forbidden"
    return text, None

